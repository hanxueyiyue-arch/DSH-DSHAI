{
  "name": "dsh-dshai-bilibili",
  "version": "0.3.16",
  "private": false,
  "description": "DSHAI 独立 Bilibili 插件：公开视频观察、发现/字幕/弹幕评论理解、本地草稿、分时读取预算、扫码登录与用户内容策略。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/browser.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.2.2-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.2",
    "@deepseek-ai/dsh-error": "0.2.2-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.2",
    "@deepseek-ai/cosmokit": "1.9.0",
    "@standard-schema/spec": "1.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "bilibili",
    "observation",
    "quota"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "bundledDependencies": [
    "@deepseek-ai/dsh-tools",
    "@deepseek-ai/schemastery",
    "@deepseek-ai/cordis",
    "@deepseek-ai/dsh-scope",
    "@deepseek-ai/dsh-llm",
    "@deepseek-ai/dsh-typert-protocol",
    "@deepseek-ai/dsh-util-crypto",
    "@deepseek-ai/dsh-timeout",
    "@deepseek-ai/dsh-error",
    "@deepseek-ai/dsh-brand",
    "@deepseek-ai/dsh-util-values",
    "@deepseek-ai/cosmokit",
    "@standard-schema/spec"
  ]
}
